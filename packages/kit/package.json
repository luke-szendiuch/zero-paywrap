{
	"name": "@zeroclickai/paywrap",
	"version": "0.0.11",
	"description": "Framework-agnostic primitives for building agent-callable paid APIs over HTTP: MPP/x402 gates, pricing manifests, credential verification, and settlement logs.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zeroclickai/zero-paywrap.git",
		"directory": "packages/kit"
	},
	"homepage": "https://github.com/zeroclickai/zero-paywrap#readme",
	"bugs": "https://github.com/zeroclickai/zero-paywrap/issues",
	"keywords": ["mpp", "x402", "tempo", "usdc", "payments", "402", "agents"],
	"publishConfig": { "access": "public" },
	"exports": {
		"./mpp": { "types": "./dist/mpp/index.d.ts", "import": "./dist/mpp/index.js" },
		"./mpp/metered": { "types": "./dist/mpp/metered.d.ts", "import": "./dist/mpp/metered.js" },
		"./x402": { "types": "./dist/x402/index.d.ts", "import": "./dist/x402/index.js" },
		"./auth": { "types": "./dist/auth/index.d.ts", "import": "./dist/auth/index.js" },
		"./signing": { "types": "./dist/signing/index.d.ts", "import": "./dist/signing/index.js" },
		"./testing": { "types": "./dist/testing/index.d.ts", "import": "./dist/testing/index.js" },
		"./crypto": { "types": "./dist/crypto/index.d.ts", "import": "./dist/crypto/index.js" },
		"./manifest": { "types": "./dist/manifest/index.d.ts", "import": "./dist/manifest/index.js" },
		"./health": { "types": "./dist/health/index.d.ts", "import": "./dist/health/index.js" },
		"./setup": { "types": "./dist/setup/index.d.ts", "import": "./dist/setup/index.js" },
		"./proxy": { "types": "./dist/proxy/index.d.ts", "import": "./dist/proxy/index.js" },
		"./logger": { "types": "./dist/logger/index.d.ts", "import": "./dist/logger/index.js" }
	},
	"files": ["dist", "README.md"],
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@x402/core": "^2.9.0",
		"@x402/evm": "^2.9.0",
		"mppx": "^0.6.2",
		"viem": "^2.21.55"
	},
	"peerDependencies": {
		"ioredis": "^5.10.1"
	},
	"peerDependenciesMeta": {
		"ioredis": { "optional": true }
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"ioredis": "^5.10.1",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8"
	}
}
