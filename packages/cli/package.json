	},
	"dependencies": {
		"@clack/prompts": "^0.8.0",
		"@zeroclickai/paywrap": "workspace:*",
		"commander": "^12.1.0",
		"dotenv": "^16.4.0",
		"execa": "^9.5.0"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8"
	}
}
