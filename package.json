{
	"name": "zero-paywrap",
	"version": "0.0.0",
	"private": true,
	"description": "Paywrap toolkit: build agent-callable paid APIs with MPP/x402 gates, pricing manifests, and settlement logs.",
	"type": "module",
	"scripts": {
		"build": "pnpm -r --filter './packages/*' build",
		"typecheck": "pnpm -r --filter './packages/*' typecheck",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"test": "pnpm -r --filter './packages/*' test"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^22.10.2",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8"
	},
	"packageManager": "pnpm@9.15.0",
	"pnpm": {
		"overrides": {
			"hono": "4.12.15"
		}
	}
}
